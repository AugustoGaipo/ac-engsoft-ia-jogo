// Level 2 — Peso (with the barriers). Rooms follow docs/design/PROGRESSAO-NIVEIS.md.
// Level space: meters, Y up, rooms side by side along +X. Floor at y = 0.
// Numbers are a first draft, tuned while building the Godot scene.
{
  "schemaVersion": 1,
  "id": "level-2",
  "number": 2,
  "name": "Peso",
  "scene": "res://levels/level_2.tscn",
  "rules": {
    "unlockedProperties": ["position", "mass"],
    "rangeMeters": { "position": 8.0, "mass": 8.0 },
    "cooldownSeconds": 1.0
  },
  "rooms": [
    {
      "id": "2.1",
      "teaches": "Barreira 1 (barra objetos): a caixa não passa, mas atravessa por troca de posição.",
      "bounds": { "min": [0, -3, 0], "max": [12, 6, 10] },
      "spawn": { "position": [1, 0, 5], "yawDegrees": -90 },
      "exit": { "min": [11.5, 0, 4], "max": [12, 3, 6] },
      // Walk through the barrier, then swap places with the box left behind.
      "objects": [
        { "id": "box-2-1", "kind": "box", "position": [3, 0.5, 3], "size": [1, 1, 1], "massKg": 10, "bounce": 0.1 }
      ],
      "buttons": [
        { "id": "button-2-1", "position": [8.5, 0, 5], "size": [1.5, 0.1, 1.5], "requiredMassKg": 5, "detects": "objects" }
      ],
      "doors": [
        { "id": "door-2-1", "box": { "min": [10, 0, 4], "max": [10.3, 3, 6] }, "opensWith": ["button-2-1"] }
      ],
      "barriers": [
        { "id": "no-objects-2-1", "blocksObjects": true, "box": { "min": [6, 0, 0], "max": [6.2, 6, 10] } },
        { "id": "exit-grid-2-1", "preset": "exitGrid", "box": { "min": [11.5, 0, 4], "max": [11.6, 3, 6] } }
      ]
    },
    {
      "id": "2.2",
      "teaches": "Barreira 2 (barra o jogador): o jogador atravessa trocando com uma caixa do outro lado.",
      "bounds": { "min": [12, -3, 0], "max": [24, 6, 10] },
      "spawn": { "position": [13, 0, 5], "yawDegrees": -90 },
      "exit": { "min": [23.5, 0, 4], "max": [24, 3, 6] },
      "objects": [
        { "id": "box-2-2", "kind": "box", "position": [20, 0.5, 5], "size": [1, 1, 1], "massKg": 10, "bounce": 0.1 }
      ],
      "barriers": [
        { "id": "no-player-2-2", "blocksPlayer": true, "box": { "min": [17, 0, 0], "max": [17.2, 6, 10] } },
        { "id": "exit-grid-2-2", "preset": "exitGrid", "box": { "min": [23.5, 0, 4], "max": [23.6, 3, 6] } }
      ]
    },
    {
      "id": "2.3",
      "teaches": "Empréstimo de peso: pegar os 300 kg da caixa para carregá-la, devolver no botão e passar pela grade trocando com a bola.",
      "bounds": { "min": [24, -3, 0], "max": [36, 6, 10] },
      "spawn": { "position": [25, 0, 5], "yawDegrees": -90 },
      "exit": { "min": [35.5, 0, 4], "max": [36, 3, 6] },
      // The crate (300 kg) is too heavy to hold (> 2.5 × 70 kg). Take its mass, carry it (70 kg) to the grid,
      // drop it in the cage on the button, give the mass back through the grid, swap places with the ball.
      // The cage keeps the player off the button (no "teleport the crate onto the button" shortcut).
      "objects": [
        { "id": "crate-2-3", "kind": "box", "position": [26.5, 0.5, 5], "size": [1, 1, 1], "massKg": 300, "accepts": ["mass"], "bounce": 0.05 },
        { "id": "ball-2-3", "kind": "ball", "position": [33, 0.25, 8.5], "size": [0.5, 0.5, 0.5], "massKg": 2, "accepts": ["position"], "bounce": 0.3 }
      ],
      "buttons": [
        { "id": "heavy-button-2-3", "position": [31.45, 0, 5], "size": [1.5, 0.1, 1.5], "requiredMassKg": 200, "detects": "objects" }
      ],
      "doors": [
        { "id": "door-2-3", "box": { "min": [34, 0, 4], "max": [34.3, 3, 6] }, "opensWith": ["heavy-button-2-3"] }
      ],
      "barriers": [
        { "id": "no-player-2-3", "blocksPlayer": true, "box": { "min": [30, 0, 0], "max": [30.2, 6, 10] } },
        { "id": "cage-2-3", "blocksPlayer": true, "box": { "min": [30.2, 0, 3.5], "max": [32.7, 3, 6.5] } },
        { "id": "exit-grid-2-3", "preset": "exitGrid", "box": { "min": [35.5, 0, 4], "max": [35.6, 3, 6] } }
      ]
    },
    {
      "id": "2.4",
      "teaches": "Pulo e queda: com 2 kg o jogador pula ~12 m sobre o muro; trocar de posição com o bloco antes de passar de 12 m/s.",
      "bounds": { "min": [36, -3, 0], "max": [48, 16, 10] },
      "spawn": { "position": [37, 0, 5], "yawDegrees": -90 },
      // From the top of the jump the block is ~13 m away: a longer reach for position in this room only.
      "rulesOverride": { "rangeMeters": { "position": 14.0, "mass": 8.0 } },
      // Scenery: an 8 m wall at x = 42–42.5 and a closed ceiling at 15 m. Take the 2 kg box's mass, jump by
      // the wall; near the top the block shows over it: swap places with it (below 12 m/s) and land safe.
      "exit": { "min": [47.5, 0, 4], "max": [48, 3, 6] },
      "objects": [
        { "id": "light-box-2-4", "kind": "box", "position": [38.5, 0.25, 3], "size": [0.5, 0.5, 0.5], "massKg": 2, "accepts": ["mass"], "bounce": 0.1 },
        { "id": "block-2-4", "kind": "box", "position": [45.5, 0.5, 5], "size": [1, 1, 1], "massKg": 10, "accepts": ["position"], "bounce": 0.05 }
      ],
      "barriers": [
        { "id": "exit-grid-2-4", "preset": "exitGrid", "box": { "min": [47.5, 0, 4], "max": [47.6, 3, 6] } }
      ]
    }
  ]
}
