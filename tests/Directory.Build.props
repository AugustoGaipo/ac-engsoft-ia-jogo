<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!--
    xunit 2.5.3 pulls NETStandard.Library 1.6.1, which brings System.Net.Http 4.3.0 and
    System.Text.RegularExpressions 4.3.0 (GHSA-7jgj-8wvc-jh57, GHSA-cmhx-cq75-c4mj, both High).
    Test projects only; the .NET 8 runtime uses its own copies anyway. Pinned to the fixed versions
    so the vulnerability audit (dotnet list package, vulnerable, include transitive) stays clean.
  -->
  <ItemGroup>
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>
</Project>
