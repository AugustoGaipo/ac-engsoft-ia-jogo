        { "id": "exit-grid-3-1", "preset": "exitGrid", "box": { "min": [11.5, 0, 4], "max": [11.6, 3, 6] } }
      ]
    },
    {
      "id": "3.2",
      "teaches": "O pulo depende da massa: com 7 kg o jogador pula ~1,8 m; com 70 kg, só 0,5 m.",
      "bounds": { "min": [12, -3, 0], "max": [24, 6, 10] },
      "spawn": { "position": [13, 0, 5], "yawDegrees": -90 },
