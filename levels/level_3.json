      "objects": [
        { "id": "light-box-3-2", "kind": "box", "position": [16, 0.25, 3], "size": [0.5, 0.5, 0.5], "massKg": 7, "bounce": 0.1 }
      ],
      "barriers": [
        { "id": "exit-grid-3-2", "preset": "exitGrid", "box": { "min": [23.5, 1.5, 4], "max": [23.6, 4.5, 6] } }
      ]
    }
